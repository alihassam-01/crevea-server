generator client {
  provider = "prisma-client"
  output   = "../services/app/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model assets {
  id           String   @id(map: "PK_assets") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  environment  String   @db.VarChar(16)
  domain       String   @db.VarChar(32)
  entityId     String   @db.VarChar
  assetType    String   @db.VarChar(32)
  assetId      String   @db.Uuid
  variant      String   @db.VarChar(32)
  objectKey    String   @unique(map: "UQ_assets_object_key") @db.VarChar
  contentHash  String   @db.VarChar(64)
  mimeType     String   @db.VarChar(64)
  size         Int
  uploadedBy   String   @db.VarChar
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @db.Timestamp(6)

  @@unique([domain, entityId, assetType, contentHash, variant], map: "UQ_assets_dedup")
  @@index([domain, entityId, assetType], map: "IDX_assets_entity")
  @@index([assetId], map: "IDX_assets_asset_id")
}

