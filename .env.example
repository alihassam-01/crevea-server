# Database Configuration
DATABASE_URL=postgresql://postgres:DB_PASSWORD@localhost:5432/crevea
REDIS_URL=redis://localhost:6379

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Event Bus Configuration
# Type: redis | kafka (kafka disabled for local dev)
EVENT_BUS_TYPE=redis

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=7d

# OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/oauth/google/callback


# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=crevea-files
R2_PUBLIC_URL=https://files.crevea.com

# PayFast Configuration
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=true

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@crevea.com

# SMS Configuration
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-twilio-account-sid
SMS_AUTH_TOKEN=your-twilio-auth-token
SMS_FROM_NUMBER=+1234567890

# Push Notification Configuration
FCM_SERVER_KEY=your-firebase-server-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_PRIVATE_KEY_PATH=./certs/apns-private-key.p8

# Application Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:9011

# Platform Configuration
PLATFORM_COMMISSION_RATE=0.15
CURRENCY=PKR
TIMEZONE=Asia/Karachi

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
